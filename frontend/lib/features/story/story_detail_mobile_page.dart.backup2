  void _showSuccessDialog(String message) {
    if (!mounted) return;
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Row(
          children: [
            Icon(FluentIcons.checkmark_circle_24_regular, color: Colors.green),
            SizedBox(width: 8),
            Text(message),
          ],
        ),
        actions: [
          fluent.FilledButton(
            onPressed: () {
              Navigator.pop(ctx);
              if (mounted) Navigator.pop(context);
            },
            child: Text('好'),
          ),
        ],
      ),
    );
  }

  void _showErrorDialog(String title, String message) {
    if (!mounted) return;
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Row(
          children: [
            Icon(FluentIcons.error_circle_24_regular, color: AppTheme.palette.danger),
            SizedBox(width: 8),
            Text(title),
          ],
        ),
        content: SelectableText(message),
        actions: [
          fluent.Button(
            onPressed: () => Navigator.pop(ctx),
            child: Text('确定'),
          ),
        ],
      ),
    );
  }

  bool _checkUnsavedChanges() {
    // TODO: 检测未保存修改的逻辑
    // 可以对比 baseline 和当前状态
    return true;
  }

  late String? _error;
}

// 工具函数（复用 story_logic.dart 中的实现）
String insertTalkId(String currentId, Map<String, dynamic> talks) {
  final base = int.tryParse(currentId.replaceAll(RegExp(r'^[^0-9]*'), ''));
  if (base == null) return '';
  var id = base + 1;
  while (talks.containsKey(id.toString())) {
    id++;
  }
  return id.toString();
}

String? allocOptionId(String prefix, Set<String> used) {
  final p = prefix.toLowerCase().trim();
  for (var i = 1; i < 100; i++) {
    final candidate = '${p}${i.toString().padLeft(2, '0')}';
    if (!used.contains(candidate)) return candidate;
  }
  return null;
}

List<dynamic> normalizeStoryIdList(dynamic value) {
  final result = <dynamic>[];
  if (value == null || value == '') return result;
  final items = value is List ? value : [value];
  for (final item in items) {
    if (item is List) {
      result.addAll(normalizeStoryIdList(item));
      continue;
    }
    final s = item.toString().trim();
    if (s.isEmpty) continue;
    result.add(int.tryParse(s) ?? s);
  }
  return result;
}

List<dynamic> ensureList(dynamic v) {
  if (v == null || v == '') return [];
  if (v is List) return v.map((e) => e.toString()).toList();
  return [v.toString()];
}

