  /// Helper Methods
  String _getTalkDisplayName(MobileTalkCfg talk) {
    if (talk.roleIds.isEmpty && talk.roleName.isEmpty) {
      return talk.id.endsWith('001') ? '旁白' : 'NPC';
    }
    
    final roles = talk.roleIds.map((id) {
      return _roleNames[id] ?? '';
    }).where((n) => n.isNotEmpty).toList();
    
    return roles.isNotEmpty ? roles.join('、') : (talk.roleName.isNotEmpty ? talk.roleName : 'NPC');
  }

  Future<void> _addNewTalk([int? insertIndex]) async {
    await MobileHaptic.mediumImpact();
    
    final newId = insertTalkId(
      _talks.isEmpty ? null : _talks.last.id,
      _event!.id,
      {...for (var t in _talks) t.id: t}.map((k, v) => k: v.toJson()),
    );
    
    if (newId.isEmpty) return;
    
    setState(() {
      final newTalk = MobileTalkCfg(
        id: newId,
        roleIds: [],
        roleName: '',
        content: '【新插入的对话】',
        nextTalk: insertIndex != null && insertIndex > 0 
            ? [newTalk] 
            : (_talks.isNotEmpty ? [_talks.first.id] : []),
        nextTalk2: [],
        options: [],
      );
      
      if (insertIndex != null) {
        _talks.insert(insertIndex, newTalk);
      } else {
        _talks.add(newTalk);
      }
    });
  }

  Future<void> _addNewOption([int? insertIndex]) async {
    await MobileHaptic.lightImpact();
    
    final prefix = _event!.id;
    final newOption = allocOptionId(prefix, {
      for (var o in _options) o.id,
    });
    
    if (newOption == null) {
      showDialog(
        context: context,
        builder: (ctx) => AlertDialog(
          title: Text('已达到选项上限'),
          content: Text('一个事件最多支持 99 个选项'),
          actions: [
            fluent.Button(
              onPressed: () => Navigator.pop(ctx),
              child: Text('确定'),
            ),
          ],
        ),
      );
      return;
    }
    
    setState(() {
      final newOpt = MobileOptionCfg(id: newOption, text: '');
      
      if (insertIndex != null) {
        _options.insert(insertIndex, newOpt);
      } else {
        _options.add(newOpt);
      }
    });
  }

  void _removeOption(int index) {
    MobileHaptic.heavyImpact();
    setState(() {
      _options.removeAt(index);
    });
  }

  Future<void> _confirmDeleteTalk(int talkIndex) async {
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text('确认删除'),
        content: Text('此操作将删除当前对白及后续关联？'),
        actions: [
          fluent.Button(
            onPressed: () => Navigator.pop(ctx, false),
            child: Text('取消'),
          ),
          fluent.FilledButton(
            onPressed: () => Navigator.pop(ctx, true),
            child: Text('删除'),
          ),
        ],
      ),
    );

    if (confirmed == true) {
      setState(() {
        _talks.removeAt(talkIndex);
      });
    }
  }

  Future<void> _confirmDelete() async {
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text('确认删除'),
        content: Text('此操作不可恢复？\n将删除事件记录但不影响 TalkCfg/OptionCfg'),
        actions: [
          fluent.Button(
            onPressed: () => Navigator.pop(ctx, false),
            child: Text('取消'),
          ),
          fluent.FilledButton(
            onPressed: () => Navigator.pop(ctx, true),
            child: Text('删除'),
          ),
        ],
      ),
    );

    if (confirmed == true) {
      await _deleteEvent();
    }
  }

  Future<void> _saveEvent() async {
    if (_saving) return;
    
    // 保存前校验
    if (_talks.isEmpty) {
      showDialog(
        context: context,
        builder: (ctx) => AlertDialog(
          title: Text('保存失败'),
          content: Text('事件必须包含至少一句对白'),
          actions: [
            fluent.Button(
              onPressed: () => Navigator.pop(ctx),
              child: Text('确定'),
            ),
          ],
        ),
      );
      return;
    }
    
    setState(() => _saving = true);
    
    try {
      final result = await _dataAccess.saveEvent(
        modName: widget.modName,
        eventId: widget.eventId,
        talks: _talks,
        options: _options,
      );

      if (!mounted) return;

      await MobileHaptic.success();
      
      _showSuccessDialog(result ? '保存成功' : '保存完成');
    } catch (e) {
      if (!mounted) return;
      await MobileHaptic.error();
      
      _showErrorDialog('保存失败', e.toString());
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  Future<void> _saveAndBack() async {
    await _saveEvent();
    if (mounted && !_saving) {
      Navigator.pop(context);
    }
  }

  Future<void> _deleteEvent() async {
    setState(() => _saving = true);
    
    try {
      await _dataAccess.deleteEvent(widget.eventId);
      
      if (mounted) {
        Navigator.pop(context);
        _showSuccessDialog('事件已删除');
      }
    } catch (e) {
      if (mounted) {
        _showErrorDialog('删除失败', e.toString());
      }
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

