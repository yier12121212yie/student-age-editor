import 'package:flutter/material.dart';
import 'package:fluent_ui/fluent_ui.dart' as fluent;
import 'package:fluentui_system_icons/fluentui_system_icons.dart';
import '../../core/api_client.dart';
import '../../core/app_theme.dart'; // 导入后可以使用 palette.xxx
import '../../core/mobile_widgets.dart';
import 'story_editor_mobile.dart';

// 移除 unused imports
/// 移动版事件详情编辑页 - 流式表单布局（上下堆叠）
class StoryDetailMobilePage extends StatefulWidget {
  const StoryDetailMobilePage({
    super.key,
    required this.modName,
    required this.eventId,
  });

  final String modName;
  final String eventId;

  @override
  State<StoryDetailMobilePage> createState() => _StoryDetailMobilePageState();
}

class _StoryDetailMobilePageState extends State<StoryDetailMobilePage> {
  final _dataAccess = StoryDataAccess();
  
  MobileEvtCfg? _event;
  List<MobileTalkCfg> _talks = [];
  List<MobileOptionCfg> _options = [];
  
  bool _loading = true;
  bool _saving = false;
  Map<String, String> _roleNames = {};

  @override
  void initState() {
    super.initState();
    _loadDetails();
  }

  Future<void> _loadDetails() async {
    setState(() {
      _loading = true;
      _error = null;
    });

    try {
      final details = await _dataAccess.loadEventDetails(
        modName: widget.modName,
        eventId: widget.eventId,
      );

      if (!mounted) return;

      setState(() {
        _event = details.event;
        _talks = details.talks;
        _options = details.options;
        
        // 加载角色字典
        _loadReferenceData();
        
        _loading = false;
      });
    } catch (e) {
      if (!mounted) return;
      
      setState(() {
        _error = e.toString();
        _loading = false;
      });

      if (mounted) {
        _showErrorDialog('加载失败', e.toString());
      }
    }
  }

  Future<void> _loadReferenceData() async {
    try {
      final personResponse = await ApiClient.instance.get('/api/cfg/PersonCfg');
      final optsResponse = await ApiClient.instance.get('/api/cfg/OptionCfg');
      
      final personData = personResponse['data'] as Map? ?? {};
      final optsData = optsResponse['data'] as Map? ?? {};

      // 只保留相关 Talk 对应的 Role
      for (final entry in personData.entries) {
        final id = entry.key;
        _roleNames[id] = (entry.value is Map
            ? (entry.value as Map)['name']?.toString()
            : entry.value.toString()) ?? '';
      }

      setState(() {});
    } catch (_) {
      // 忽略错误
    }
  }

  String? _error;

  @override
  Widget build(BuildContext context) {
    if (_loading) {
      return Scaffold(
        appBar: AppBar(
          backgroundColor: AppTheme.palette.bg,
          elevation: 0,
          leading: IconButton(
            icon: const Icon(FluentIcons.arrow_left_24_regular, color: Colors.white),
            onPressed: () => Navigator.pop(context),
          ),
          title: Text('加载中...'),
        ),
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              SizedBox(
                width: 24,
                height: 24,
                child: fluent.ProgressRing(strokeWidth: 2),
              ),
              SizedBox(height: 12),
              flexibleText('正在加载剧情数据...'),
            ],
          ),
        ),
      );
    }

    if (_error != null) {
      return Scaffold(
        appBar: AppBar(
          backgroundColor: AppTheme.palette.bg,
          elevation: 0,
          leading: IconButton(
            icon: const Icon(FluentIcons.arrow_left_24_regular, color: Colors.white),
            onPressed: () => Navigator.pop(context),
          ),
          title: Text('加载失败'),
        ),
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(
                FluentIcons.error_circle_24_regular,
                size: 48,
                color: AppTheme.palette.danger,
              ),
              SizedBox(height: 16),
              Text(
                '加载失败：$_error',
                style: TextStyle(fontSize: 12, color: AppTheme.palette.danger),
                textAlign: TextAlign.center,
              ),
              SizedBox(height: 16),
              fluent.FilledButton(
                onPressed: _loadDetails,
                child: flexibleText('重试'),
              ),
            ],
          ),
        ),
      );
    }

    if (_event == null) {
      return Scaffold(
        appBar: AppBar(
          backgroundColor: AppTheme.palette.bg,
          elevation: 0,
          leading: IconButton(
            icon: const Icon(FluentIcons.arrow_left_24_regular, color: Colors.white),
            onPressed: () => Navigator.pop(context),
          ),
          title: Text('事件不存在'),
        ),
        body: Center(
          child: flexibleText('该事件已被删除或不存在'),
        ),
      );
    }

    return Scaffold(
      appBar: _buildAppBar(),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            _buildEventInfoSection(),
            SizedBox(height: 24),
            _buildTalkSection(),
            SizedBox(height: 24),
            _buildOptionsSection(),
            SizedBox(height: 24),
            _buildActionsSection(),
          ],
        ),
      ),
    );
  }

  PreferredSizeWidget _buildAppBar() {
    return AppBar(
      backgroundColor: AppTheme.palette.bg,
      elevation: 0,
      leading: IconButton(
        icon: const Icon(FluentIcons.arrow_left_24_regular, color: Colors.white),
        onPressed: () {
          if (_checkUnsavedChanges()) {
            Navigator.pop(context);
          }
        },
        tooltip: '返回',
      ),
      title: Row(
        children: [
          Icon(FluentIcons.document_24_regular, size: 16, color: AppTheme.palette.textPrimary),
          SizedBox(width: 8),
          Expanded(
            child: Text(
              _event!.id,
              style: TextStyle(
                fontSize: 16,
                fontWeight: FontWeight.w600,
                color: AppTheme.palette.textPrimary,
              ),
              overflow: TextOverflow.ellipsis,
            ),
          ),
        ],
      ),
      actions: [
        // 预览按钮 - placeholder
        IconButton(
          icon: Icon(FluentIcons.eye_24_regular, color: Colors.white), // 替换为实际存在的图标
          onPressed: _previewEvent,
        ),
        SizedBox(width: 4),
        // 保存按钮
        if (_saving) ...[
          Padding(
            padding: const EdgeInsets.all(4),
            child: SizedBox(
              width: 24,
              height: 24,
              child: fluent.ProgressRing(strokeWidth: 2),
            ),
          ),
        ] else ...[
          Tooltip(
            message: '保存',
            child: IconButton(
              icon: Icon(FluentIcons.checkmark_24_regular, color: Colors.greenAccent),
              onPressed: _saveEvent,
            ),
          ),
          SizedBox(width: 4),
        ],
        // 删除按钮
        Tooltip(
          message: '删除事件',
          child: IconButton(
            icon: Icon(FluentIcons.delete_24_regular, color: AppTheme.palette.danger),
            onPressed: _confirmDelete,
          ),
        ),
      ],
    );
  }

  Widget _buildEventInfoSection() {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: AppTheme.palette.card,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: AppTheme.palette.border),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(
                FluentIcons.document_edit_24_regular, // 替换 event_request_24_regular
                size: 16,
                color: AppTheme.palette.textSecondary,
              ),
              SizedBox(width: 6),
              Text(
                '事件信息',
                style: TextStyle(
                  fontSize: 14,
                  fontWeight: FontWeight.w600,
                  color: AppTheme.palette.textPrimary,
                ),
              ),
            ],
          ),
          
          SizedBox(height: 16),
          
          // 标题字段（可编辑）
          Row(
            children: [
              Icon(
                FluentIcons.edit_24_regular,
                size: 14,
                color: AppTheme.palette.textMuted,
              ),
              SizedBox(width: 4),
              Text(
                '标题',
                style: TextStyle(fontSize: 11, color: AppTheme.palette.textSecondary),
              ),
            ],
          ),
          SizedBox(height: 4),
          TextField(
            controller: TextEditingController(text: _event!.title),
            onChanged: (value) {
              setState(() => _event!.title = value);
            },
            decoration: InputDecoration(
              hintText: '输入事件标题',
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(8),
                borderSide: BorderSide.none,
              ),
              filled: true,
              fillColor: AppTheme.palette.bgDeep.withValues(alpha: 0.5),
            ),
          ),
          
          SizedBox(height: 12),
          
          // 类型字段（只读）
          Row(
            children: [
              Icon(
                FluentIcons.info_24_regular,
                size: 14,
                color: AppTheme.palette.textMuted,
              ),
              SizedBox(width: 4),
              Text(
                '类型',
                style: TextStyle(fontSize: 11, color: AppTheme.palette.textSecondary),
              ),
            ],
          ),
          SizedBox(height: 4),
          _buildTypeChip(_event!.type),
        ],
      ),
    );
  }

  Widget _buildTypeChip(int type) {
    const types = {
      0: '回合开始触发',
      1: '可跳过',
      2: '社交触发',
      3: '回合后触发',
      4: '行动触发',
      10: '不可跳过',
      11: '约会',
      12: '篮球任务',
      13: '篮球任务 (不自动)',
      14: '羽毛球任务',
      15: '羽毛球任务 (不自动)',
      20: '关系任务',
      21: '打招呼',
      22: '话题',
      30: '场景物品',
      40: '考试',
      41: '看成绩',
      42: '学习',
      50: '通知',
      51: '流程',
      60: '状态',
      70: '打电话',
      71: '接电话',
      80: '新闻',
      90: '节日',
      101: '独立按钮',
      102: '精力≤20 显示',
      104: '捣蛋事件',
      110: '送礼',
      131: '社团活动',
      200: '人生轨迹',
      500: '高考',
      520: '表白',
      522: '恋爱社交',
      523: '生日礼物',
    };
    
    final label = types[type] ?? '类型 $type';
    
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
      decoration: BoxDecoration(
        color: palette.statusWarn.withValues(alpha: 0.15),
        borderRadius: BorderRadius.circular(6),
        border: Border.all(color: palette.statusWarn.withValues(alpha: 0.3)),
      ),
      child: Text(
        label,
        style: TextStyle(fontSize: 11, color: palette.statusWarn),
      ),
    );
  }

  Widget _buildTalkSection() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // 标题行
        Row(
          children: [
            Icon(
              FluentIcons.document_24_regular,
              size: 16,
              color: AppTheme.palette.textSecondary,
            ),
            SizedBox(width: 6),
            Text(
              '对白配置 (${_talks.length} 条)',
              style: TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.w600,
                color: AppTheme.palette.textPrimary,
              ),
            ),
            const Spacer(),
            // 添加对白按钮
            GestureDetector(
              onTap: _addNewTalk,
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: const Color(0xFF4F6EF7).withValues(alpha: 0.15),
                  borderRadius: BorderRadius.circular(6),
                  border: Border.all(color: const Color(0xFF4F6EF7).withValues(alpha: 0.3)),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(
                      FluentIcons.add_24_regular,
                      size: 12,
                      color: const Color(0xFF4F6EF7),
                    ),
                    SizedBox(width: 4),
                    Text(
                      '新建对话',
                      style: TextStyle(fontSize: 10, color: const Color(0xFF4F6EF7)),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
        
        SizedBox(height: 16),
        
        // Talk 列表（卡片化）
        ListView.separated(
          shrinkWrap: true,
          physics: NeverScrollableScrollPhysics(),
          itemCount: _talks.length,
          separatorBuilder: (_, __) => SizedBox(height: 16),
          itemBuilder: (context, index) {
            final talk = _talks[index];
            return _buildTalkCard(talk, index);
          },
        ),
      ],
    );
  }

  Widget _buildTalkCard(MobileTalkCfg talk, int index) {
    final displayName = _getTalkDisplayName(talk);
    
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: AppTheme.palette.bgDeep,
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: AppTheme.palette.border),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // 第一行：序号 + 说话人 + 内容摘要
          Row(
            children: [
              // 序号标签
              Container(
                width: 32,
                height: 32,
                decoration: BoxDecoration(
                  color: AppTheme.palette.card,
                  borderRadius: BorderRadius.circular(6),
                  border: Border.all(
                    color: talk.id == '001' 
                        ? const Color(0xFF0F7B0F)
                        : AppTheme.palette.border,
                    width: talk.id == '001' ? 2 : 1,
                  ),
                ),
                alignment: Alignment.center,
                child: Text(
                  talk.id.substring(talk.id.length - 3),
                  style: TextStyle(
                    fontSize: 10,
                    color: talk.id == '001' 
                        ? const Color(0xFF0F7B0F)
                        : AppTheme.palette.textMuted,
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ),
              
              SizedBox(width: 12),
              
              // 说话人标识
              Expanded(
                child: Row(
                  children: [
                    Icon(
                      FluentIcons.person_24_regular,
                      size: 12,
                      color: AppTheme.palette.textSecondary,
                    ),
                    SizedBox(width: 4),
                    Flexible(
                      child: Text(
                        displayName,
                        style: TextStyle(
                          fontSize: 11,
                          color: AppTheme.palette.textPrimary,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
              
              // 首句标记
              if (talk.id.endsWith('001')) ...[
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 2),
                  decoration: BoxDecoration(
                    color: const Color(0xFF0F7B0F).withValues(alpha: 0.15),
                    borderRadius: BorderRadius.circular(4),
                  ),
                  child: Text(
                    '开场',
                    style: TextStyle(
                      fontSize: 8,
                      color: const Color(0xFF0F7B0F),
                    ),
                  ),
                ),
                SizedBox(width: 8),
              ],
            ],
          ),
          
          SizedBox(height: 12),
          
          // 对白内容区域
          TextFormField(
            initialValue: talk.content,
            maxLines: null,
            minLines: 3,
            keyboardType: TextInputType.multiline,
            decoration: InputDecoration(
              hintText: '输入对白内容\n使用 \${speaker} 等占位符',
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(8),
                borderSide: BorderSide.none,
              ),
              filled: true,
              fillColor: AppTheme.palette.bgDeep2.withValues(alpha: 0.5),
              helperText: '', // 移除辅助文字干扰
              contentPadding: const EdgeInsets.all(12),
            ),
            onChanged: (value) {
              setState(() => talk.content = value);
            },
          ),
          
          // 常用占位符快捷按钮
          SizedBox(height: 8),
          Wrap(
            spacing: 6,
            runSpacing: 6,
            children: [
              ..._placeholderSuggestions.map((tag) {
                // 只过滤当前对话中已存在的 tag
                return InkWell(
                  onTap: () {
                    MobileHaptic.lightImpact();
                    final newContent = talk.content.isEmpty 
                        ? tag 
                        : '${talk.content}\n$tag';
                    setState(() => talk.content = newContent);
                  },
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(
                      color: AppTheme.palette.hover,
                      borderRadius: BorderRadius.circular(4),
                    ),
                    child: Text(
                      tag,
                      style: TextStyle(
                        fontSize: 9,
                        color: AppTheme.palette.textHigh,
                      ),
                    ),
                  ),
                );
              }),
            ],
          ),
          
          SizedBox(height: 12),
          
          // 跳转设置区域
          if (talk.nextTalk.isNotEmpty || talk.nextTalk2.isNotEmpty) ...[
            Row(
              children: [
                Icon(
                  FluentIcons.link_24_regular,
                  size: 12,
                  color: AppTheme.palette.textSecondary,
                ),
                SizedBox(width: 4),
                Text(
                  '后续跳转',
                  style: TextStyle(fontSize: 10, color: AppTheme.palette.textSecondary),
                ),
              ],
            ),
            SizedBox(height: 8),
            Wrap(
              spacing: 6,
              runSpacing: 4,
              children: [
                if (talk.nextTalk.isNotEmpty) ...[
                  _jumpChip(
                    talk.nextTalk.first.toString(),
                    '成功时跳转到下一句',
                  ),
                ],
                if (talk.nextTalk2.isNotEmpty) ...[
                  _jumpChip(
                    talk.nextTalk2.first.toString(),
                    '失败时跳转到下一句',
                    isError: true,
                  ),
                ],
              ],
            ),
          ],
          
          // 删除按钮
          Align(
            alignment: Alignment.centerRight,
            child: GestureDetector(
              onTap: () => _confirmDeleteTalk(index),
              child: Text(
                '删除此句对话',
                style: TextStyle(
                  fontSize: 9,
                  color: AppTheme.palette.danger,
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildJumpChip(String targetId, String tooltip, {bool isError = false}) {
    final targetIndex = targetId.substring(targetId.length - 3);
    
    return PopupMenuButton(
      icon: Icon(
        FluentIcons.more_horizontal_24_regular,
        size: 12,
        color: isError ? AppTheme.palette.danger : palette.statusInfo,
      ),
      itemBuilder: (context) => [
        PopupMenuItem(
          child: Row(
            children: [
              Icon(
                FluentIcons.arrow_right_24_regular,
                size: 12,
                color: isError ? AppTheme.palette.danger : palette.statusInfo,
              ),
              SizedBox(width: 8),
              Text('$targetId → $targetIndex'),
            ],
          ),
        ),
      ],
      tooltip: tooltip,
      child: Chip(
        avatar: Icon(
          FluentIcons.question_24_regular,
          size: 10,
          color: isError ? AppTheme.palette.danger : palette.statusInfo,
        ),
        label: Text(
          '$targetIndex?',
          style: TextStyle(
            fontSize: 8,
            color: isError ? AppTheme.palette.danger : palette.statusInfo,
          ),
        ),
        materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
      ),
    );
  }

  Widget _buildOptionsSection() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            Icon(
              FluentIcons.split_group_24_regular,
              size: 16,
              color: AppTheme.palette.textSecondary,
            ),
            SizedBox(width: 6),
            Text(
              '选项分支 (${_options.length} 个)',
              style: TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.w600,
                color: AppTheme.palette.textPrimary,
              ),
            ),
            const Spacer(),
            // 添加选项按钮
            GestureDetector(
              onTap: _addNewOption,
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: const Color(0xFF0F7B0F).withValues(alpha: 0.15),
                  borderRadius: BorderRadius.circular(6),
                  border: Border.all(color: const Color(0xFF0F7B0F).withValues(alpha: 0.3)),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(
                      FluentIcons.add_24_regular,
                      size: 12,
                      color: const Color(0xFF0F7B0F),
                    ),
                    SizedBox(width: 4),
                    Text(
                      '添加选项',
                      style: TextStyle(fontSize: 10, color: const Color(0xFF0F7B0F)),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
        
        SizedBox(height: 16),
        
        // Option 列表
        ListView.separated(
          shrinkWrap: true,
          physics: NeverScrollableScrollPhysics(),
          itemCount: _options.isEmpty ? 1 : _options.length,
          separatorBuilder: (_, __) => SizedBox(height: 16),
          itemBuilder: (context, index) {
            if (_options.isEmpty && index == 0) {
              return _buildAddOptionRow(null);
            }
            final option = _options[index];
            return _buildOptionCard(option, index);
          },
        ),
      ],
    );
  }

  Widget _buildOptionCard(MobileOptionCfg option, int index) {
    final optionIndex = index + 1;
    
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: AppTheme.palette.bgDeep,
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: AppTheme.palette.border),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // 选项标题行
          Row(
            children: [
              // 序号圆圈
              Container(
                width: 24,
                height: 24,
                decoration: BoxDecoration(
                  color: AppTheme.palette.card,
                  shape: BoxShape.circle,
                  border: Border.all(
                    color: const Color(0xFF4F6EF7).withValues(alpha: 0.3),
                    width: 1.5,
                  ),
                ),
                alignment: Alignment.center,
                child: Text(
                  '$optionIndex',
                  style: TextStyle(
                    fontSize: 10,
                    color: const Color(0xFF4F6EF7),
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ),
              
              SizedBox(width: 12),
              
              // 选项文本输入
              Expanded(
                child: TextField(
                  decoration: InputDecoration(
                    hintText: '选项文本（例如："我愿意！"）',
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(6),
                      borderSide: BorderSide.none,
                    ),
                    filled: true,
                    fillColor: AppTheme.palette.bgDeep2.withValues(alpha: 0.5),
                    contentPadding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
                  ),
                  maxLines: null,
                  minLines: 1,
                  controller: TextEditingController(text: option.text),
                  onChanged: (value) {
                    setState(() => option.text = value);
                  },
                ),
              ),
              
              // 删除按钮
              IconButton(
                icon: Icon(
                  FluentIcons.delete_24_regular,
                  size: 14,
                  color: AppTheme.palette.danger,
                ),
                onPressed: () => _removeOption(index),
                padding: EdgeInsets.zero,
                constraints: BoxConstraints(),
              ),
            ],
          ),
          
          // 条件跳转区域
          SizedBox(height: 12),
          Container(
            padding: const EdgeInsets.all(8),
            decoration: BoxDecoration(
